{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prodocux.local/pdx-local-ai/pdx_local_block_instance_v1.schema.json",
  "title": "PDX Local AI block instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "source_version_id", "projection_id", "block_instance_id", "ordinal", "block_type", "text", "text_sha256", "locator"],
  "properties": {
    "schema_version": {"const": "pdx_local_block_instance_v1"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "source_version_id": {"type": "string", "format": "uuid"},
    "projection_id": {"type": "string", "format": "uuid"},
    "block_instance_id": {"type": "string", "format": "uuid"},
    "parent_block_instance_id": {"type": ["string", "null"], "format": "uuid"},
    "ordinal": {"type": "integer", "minimum": 0},
    "block_type": {"type": "string", "minLength": 1},
    "text": {"type": "string"},
    "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "locator": {"$ref": "#/$defs/locator"}
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["page", "paragraph", "table", "cell", "structural"]},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
