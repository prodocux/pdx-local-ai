{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prodocux.local/pdx-local-ai/pdx_local_document_projection_v1.schema.json",
  "title": "PDX Local AI document projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "source_root_id", "file_record_id", "source_version_id", "projection_id", "source_sha256", "parser_contract", "block_count", "published_at"],
  "properties": {
    "schema_version": {"const": "pdx_local_document_projection_v1"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "source_root_id": {"type": "string", "format": "uuid"},
    "file_record_id": {"type": "string", "format": "uuid"},
    "source_version_id": {"type": "string", "format": "uuid"},
    "projection_id": {"type": "string", "format": "uuid"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "distribution", "distribution_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "distribution": {"const": "prodocux"},
        "distribution_version": {"const": "0.3.0rc9"}
      }
    },
    "block_count": {"type": "integer", "minimum": 0},
    "kernel_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "published_at": {"type": "string", "format": "date-time"}
  }
}
