{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prodocux.dev/schemas/local-ai/pdx_local_durable_promotion_request_v1.schema.json",
  "title":"Proposed durable promotion request v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","workspace_id","principal_id","source_working_memory_ids","target_kind","proposed_content","requested_authority_id","idempotency_key","proposer_actor_id","proposer_actor_kind"],
  "properties":{
    "schema_version":{"const":"pdx_local_durable_promotion_request_v1"},
    "request_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"principal_id":{"type":"string","minLength":1},
    "source_working_memory_ids":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"type":"string","format":"uuid"}},
    "target_kind":{"enum":["l2_durable","l3_canonical"]},"target_id":{"type":["string","null"],"format":"uuid"},
    "proposed_content":{"type":"string","minLength":1,"maxLength":100000},
    "requested_memory_kind":{"enum":["fact","preference","decision","task","note"]},
    "requested_authority_id":{"type":"string","minLength":1},"idempotency_key":{"type":"string","minLength":16,"maxLength":200},
    "proposer_actor_id":{"type":"string","minLength":1},"proposer_actor_kind":{"enum":["human","model"]}
  },
  "allOf":[
    {"if":{"properties":{"target_kind":{"const":"l2_durable"}}},"then":{"required":["requested_memory_kind"]}},
    {"if":{"properties":{"target_kind":{"const":"l3_canonical"}}},"then":{"not":{"required":["requested_memory_kind"]}}}
  ]
}
