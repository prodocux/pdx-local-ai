{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prodocux.dev/schemas/local-ai/pdx_local_retrieval_escalation_request_v1.schema.json",
  "title":"Gate 4C retrieval escalation request v1","type":"object","additionalProperties":false,
  "required":["schema_version","request_id","query_id","workspace_id","principal_id","selected_memory_layer","allow_vector_escalation","allow_document_expansion","trusted_authorizer_kind","source_root_ids","policy_id","policy_version","policy_sha256","aggregate_limits","created_at"],
  "properties":{
    "schema_version":{"const":"pdx_local_retrieval_escalation_request_v1"},"request_id":{"type":"string","format":"uuid"},"query_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"principal_id":{"type":"string","minLength":1},
    "selected_memory_layer":{"enum":["l2","l3"]},"allow_vector_escalation":{"type":"boolean"},"allow_document_expansion":{"type":"boolean"},"allow_rerank":{"type":"boolean"},"trusted_authorizer_kind":{"const":"product_control_plane"},
    "source_root_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","format":"uuid"}},"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"policy_sha256":{"$ref":"#/$defs/digest"},
    "aggregate_limits":{"$ref":"#/$defs/limits"},"created_at":{"type":"string","format":"date-time"}
  },
  "allOf":[
    {"if":{"properties":{"allow_document_expansion":{"const":true}}},"then":{"properties":{"source_root_ids":{"minItems":1}}}},
    {"if":{"properties":{"allow_document_expansion":{"const":false}}},"then":{"properties":{"source_root_ids":{"maxItems":0}}}}
  ],
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "limits":{"type":"object","additionalProperties":false,"required":["lexical_candidates","vector_candidates","fused_candidates","results","document_files","document_blocks","returned_bytes","elapsed_ms"],"properties":{"lexical_candidates":{"type":"integer","minimum":1},"vector_candidates":{"type":"integer","minimum":0},"fused_candidates":{"type":"integer","minimum":1},"results":{"type":"integer","minimum":1},"document_files":{"type":"integer","minimum":0},"document_blocks":{"type":"integer","minimum":0},"returned_bytes":{"type":"integer","minimum":1},"elapsed_ms":{"type":"integer","minimum":1}}}
  }
}
