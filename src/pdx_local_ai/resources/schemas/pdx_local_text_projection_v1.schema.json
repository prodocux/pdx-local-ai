{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prodocux.local/pdx-local-ai/pdx_local_text_projection_v1.schema.json",
  "title": "PDX Local AI text projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "source_root_id", "file_record_id", "source_version_id", "projection_id", "source_sha256", "parser_contract", "decoder_profile", "normalization_profile", "block_count", "locator_contract_version", "published_at"],
  "properties": {
    "schema_version": {"const": "pdx_local_text_projection_v1"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "source_root_id": {"type": "string", "format": "uuid"},
    "file_record_id": {"type": "string", "format": "uuid"},
    "source_version_id": {"type": "string", "format": "uuid"},
    "projection_id": {"type": "string", "format": "uuid"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "distribution", "distribution_version"],
      "properties": {
        "name": {"const": "pdx_local_text_decoder"},
        "version": {"const": "1"},
        "distribution": {"const": "pdx-local-ai"},
        "distribution_version": {"const": "pdx_local_text_projection_v1"}
      }
    },
    "decoder_profile": {"enum": ["utf-8", "utf-8-bom", "utf-16-le-bom", "utf-16-be-bom"]},
    "normalization_profile": {"const": "pdx_local_text_normalization_nfc_v1"},
    "block_count": {"type": "integer", "minimum": 0},
    "locator_contract_version": {"const": "text_line_codepoint_v1"},
    "published_at": {"type": "string", "format": "date-time"}
  }
}
