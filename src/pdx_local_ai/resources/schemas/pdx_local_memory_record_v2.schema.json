{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prodocux.dev/schemas/local-ai/pdx_local_memory_record_v2.schema.json",
  "title":"Proposed additive L2 memory content v2","type":"object","additionalProperties":false,
  "required":["schema_version","memory_id","workspace_id","principal_id","memory_kind","content","content_sha256","status","confidence","salience","source_binding_id","supersedes_target","created_at","updated_at"],
  "properties":{"schema_version":{"const":"pdx_local_memory_record_v2"},"memory_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"principal_id":{"type":"string","minLength":1},"memory_kind":{"enum":["fact","preference","decision","task","note"]},"content":{"type":"string","minLength":1,"maxLength":100000},"content_sha256":{"$ref":"#/$defs/digest"},"status":{"enum":["active","superseded","retracted"]},"confidence":{"type":"number","minimum":0,"maximum":1},"salience":{"type":"number","minimum":0,"maximum":1},"source_binding_id":{"type":"string","format":"uuid"},"supersedes_target":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/target"}]},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},
  "$defs":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"target":{"type":"object","additionalProperties":false,"required":["content_contract_version","memory_id"],"properties":{"content_contract_version":{"enum":["pdx_local_memory_record_v1","pdx_local_memory_record_v2"]},"memory_id":{"type":"string","format":"uuid"}}}}
}
