{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/local-ai/pdx_local_memory_promotion_receipt_v1.schema.json",
  "title": "Proposed L0 to L1 promotion receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "promotion_receipt_id", "workspace_id", "principal_id", "idempotency_key", "session_item_id", "working_memory_id", "target_scope_id", "source_content_sha256", "target_content_sha256", "provenance_category", "verification_status", "actor_id", "created_at"],
  "properties": {
    "schema_version": {"const": "pdx_local_memory_promotion_receipt_v1"},
    "promotion_receipt_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 200},
    "session_item_id": {"type": "string", "format": "uuid"},
    "working_memory_id": {"type": "string", "format": "uuid"},
    "target_scope_id": {"type": "string", "minLength": 1},
    "source_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance_category": {"enum": ["user_stated", "document_grounded", "model_proposed"]},
    "verification_status": {"enum": ["unverified", "user_asserted", "citation_verified"]},
    "actor_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"provenance_category": {"const": "model_proposed"}}}, "then": {"properties": {"verification_status": {"const": "unverified"}}}},
    {"if": {"properties": {"provenance_category": {"const": "user_stated"}}}, "then": {"properties": {"verification_status": {"const": "user_asserted"}}}},
    {"if": {"properties": {"provenance_category": {"const": "document_grounded"}}}, "then": {"properties": {"verification_status": {"const": "citation_verified"}}}}
  ]
}
