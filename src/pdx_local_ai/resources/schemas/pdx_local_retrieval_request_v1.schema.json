{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prodocux.local/pdx-local-ai/pdx_local_retrieval_request_v1.schema.json",
  "title": "PDX Local AI retrieval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "workspace_id", "principal_id", "query_text", "eligible_source_root_ids", "limits"],
  "properties": {
    "schema_version": {"const": "pdx_local_retrieval_request_v1"},
    "query_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "eligible_source_root_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "limits": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_candidates", "lexical_candidates", "opened_files", "opened_blocks", "returned_bytes", "elapsed_ms"],
      "properties": {
        "metadata_candidates": {"type": "integer", "minimum": 1},
        "lexical_candidates": {"type": "integer", "minimum": 1},
        "opened_files": {"type": "integer", "minimum": 0},
        "opened_blocks": {"type": "integer", "minimum": 0},
        "returned_bytes": {"type": "integer", "minimum": 0},
        "elapsed_ms": {"type": "integer", "minimum": 1}
      }
    }
  }
}
