{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prodocux.dev/schemas/local-ai/pdx_local_workspace_reviewer_grant_v1.schema.json",
  "title":"Gate 4B-2 workspace reviewer grant proposal v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","grant_id","workspace_id","reviewer_actor_id","reviewer_actor_kind","workspace_authority_id","authorized_namespaces","status","issuer_actor_id","payload_sha256","issued_at","revoked_at"],
  "properties":{
    "schema_version":{"const":"pdx_local_workspace_reviewer_grant_v1"},
    "grant_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},
    "reviewer_actor_id":{"type":"string","minLength":1},"reviewer_actor_kind":{"const":"human"},
    "workspace_authority_id":{"type":"string","minLength":1},
    "authorized_namespaces":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},
    "status":{"enum":["active","revoked"]},"issuer_actor_id":{"type":"string","minLength":1},
    "payload_sha256":{"$ref":"#/$defs/digest"},"issued_at":{"type":"string","format":"date-time"},
    "revoked_at":{"type":["string","null"],"format":"date-time"}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"active"}}},"then":{"properties":{"revoked_at":{"type":"null"}}}},
    {"if":{"properties":{"status":{"const":"revoked"}}},"then":{"properties":{"revoked_at":{"type":"string","format":"date-time"}}}}
  ],
  "$defs":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
