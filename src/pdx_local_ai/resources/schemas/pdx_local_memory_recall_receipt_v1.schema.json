{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/local-ai/pdx_local_memory_recall_receipt_v1.schema.json",
  "title": "PDX Local AI memory recall receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "query_id", "workspace_id", "principal_id", "mode", "candidate_limit", "candidates_consumed", "result_limit", "result_count", "embedding_adapter_id", "created_at"],
  "properties": {
    "schema_version": {"const": "pdx_local_memory_recall_receipt_v1"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "query_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "principal_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["lexical", "hybrid"]},
    "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "candidates_consumed": {"type": "integer", "minimum": 0, "maximum": 500},
    "result_limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "result_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "embedding_adapter_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
