{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prodocux.local/pdx-local-ai/pdx_local_secret_denylist_audit_v1.schema.json",
  "title": "PDX Local AI secret denylist audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "source_root_id", "matched_rule_id", "created_at"],
  "properties": {
    "schema_version": {"const": "pdx_local_secret_denylist_audit_v1"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "source_root_id": {"type": "string", "format": "uuid"},
    "matched_rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
