{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://prodocux.dev/schemas/local-ai/pdx_local_canonical_knowledge_version_v1.schema.json","title":"Proposed canonical knowledge version v1","type":"object","additionalProperties":false,
