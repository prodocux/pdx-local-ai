{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prodocux.dev/schemas/local-ai/pdx_local_memory_source_binding_v1.schema.json",
  "title":"Proposed immutable L2 v2 source binding v1","type":"object","additionalProperties":false,
  "required":["schema_version","source_binding_id","memory_id","workspace_id","principal_id","provenance_category","verification_status","source_working_memories","citation_ids","authorization_snapshot_sha256","authority_id","decision_id","publication_receipt_id","created_at"],
  "properties":{"schema_version":{"const":"pdx_local_memory_source_binding_v1"},"source_binding_id":{"type":"string","format":"uuid"},"memory_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"principal_id":{"type":"string","minLength":1},"provenance_category":{"enum":["document_grounded","user_stated","model_proposed"]},"verification_status":{"enum":["citation_verified","user_asserted","unverified"]},"source_working_memories":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"$ref":"#/$defs/source"}},"citation_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","format":"uuid"}},"authorization_snapshot_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},"authority_id":{"type":"string","minLength":1},"decision_id":{"type":"string","format":"uuid"},"publication_receipt_id":{"type":"string","format":"uuid"},"created_at":{"type":"string","format":"date-time"}},
  "allOf":[{"if":{"properties":{"provenance_category":{"const":"document_grounded"}}},"then":{"properties":{"verification_status":{"const":"citation_verified"},"citation_ids":{"minItems":1},"authorization_snapshot_sha256":{"$ref":"#/$defs/digest"}}}},{"if":{"properties":{"provenance_category":{"const":"user_stated"}}},"then":{"properties":{"verification_status":{"const":"user_asserted"},"citation_ids":{"maxItems":0},"authorization_snapshot_sha256":{"type":"null"}}}},{"if":{"properties":{"provenance_category":{"const":"model_proposed"}}},"then":{"properties":{"verification_status":{"const":"unverified"},"citation_ids":{"maxItems":0},"authorization_snapshot_sha256":{"type":"null"}}}}],
  "$defs":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source":{"type":"object","additionalProperties":false,"required":["working_memory_id","content_sha256","state","expires_at"],"properties":{"working_memory_id":{"type":"string","format":"uuid"},"content_sha256":{"$ref":"#/$defs/digest"},"state":{"const":"active"},"expires_at":{"type":"string","format":"date-time"}}}}
}
